# === LLM ===
GEMINI_API_KEY=AIzaSy...
# Model selection (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# === Database ===
POSTGRES_PASSWORD=choose_a_strong_password

# === Credential Vault Encryption ===
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_KEY=a0JtUf83MMuwcU4gLxS1CCUKWODYH5OZ8Pa-W-9mBZA=
VAULT_PATH=./vault/credentials.enc

# === LangFuse Observability ===
# Generate secret: openssl rand -hex 32
LANGFUSE_SECRET=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# === External APIs ===
TAVILY_API_KEY=tvly-...           # https://tavily.com — web search for research tasks

# === Gmail OAuth (for email agent) ===
# Setup: https://developers.google.com/gmail/api/quickstart/python
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# === Notifications (optional but recommended) ===
# When an approval is required, the agent sends a Slack message so you don't have to poll
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# === Local LLM fallback (optional) ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# === Internal service URLs (set automatically in Docker) ===
DATABASE_URL=postgresql://agent:${POSTGRES_PASSWORD}@localhost:5432/agentdb
REDIS_URL=redis://localhost:6379
CHROMA_URL=http://localhost:8001
